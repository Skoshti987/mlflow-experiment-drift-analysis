# Environment Configuration Template (Do not put actual secrets or credentials here)
# Copy this file to .env if you need to customize your local MLflow tracking URI

# Local MLflow Tracking URI (default is local directory ./mlruns)
MLFLOW_TRACKING_URI=./mlruns

# MLflow UI Server Settings
MLFLOW_HOST=127.0.0.1
MLFLOW_PORT=5000

# Experiment Configuration
MLFLOW_EXPERIMENT_NAME=Iris_MLflow_Drift_Analysis
